<html>
	<head>
		<title>About</title>
	</head>
	<body>
		<h1>About Webber</h1>
		<div>
			<pre>
				Webber is a command-line web browser.
			</pre>
			<table>
				<tr>
					<th>Version</th>
					<td>{{ version }}</td>
				</tr>
				<tr>
					<th>Build Timestamp</th>
					<td>{{ timestamp }}</td>
				</tr>
				<tr>
					<th>Author</th>
					<td>{{ author }}</td>
				</tr>
				<tr>
					<th>Email</th>
					<td>mailto:{{ email }}</td>
				</tr>
			</table>
		</div>
		<footer>
			<p>* <i>Hit &lt;BACK&gt; to return to the previous page.</i></p>
		</footer>
	</body>
</html>
